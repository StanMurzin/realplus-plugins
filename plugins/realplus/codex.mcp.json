{
  "mcpServers": {
    "realplus": {
      "command": "cmd.exe",
      "args": ["/d", "/s", "/c", "call", "./scripts/launch.cmd"],
      "cwd": ".",
      "env_vars": [
        "PATH", "PATHEXT", "SYSTEMROOT", "WINDIR", "COMSPEC", "TEMP", "TMP",
        "USERPROFILE", "HOMEDRIVE", "HOMEPATH", "APPDATA", "LOCALAPPDATA",
        "CODEX_MCP_NODE_PATH", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "NODE_EXTRA_CA_CERTS"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 300,
      "tools": {
        "realplus_sql": { "approval_mode": "approve" }
      }
    }
  }
}
